
{% if customer %}
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

    /* Premium CSS Reset and Variables */
    :root {
      --primary-color: {{ block.settings.primary_color | default: '#0A2540' }};
      --primary-hover: {{ block.settings.primary_color | color_lighten: 10 | default: '#11355A' }};
      --border-color: rgba(223, 227, 232, 0.9);
      --bg-color: {{ block.settings.bg_color | default: '#ffffff' }};
      --error-color: #d82c0d;
      --success-color: #008060;
      --text-main: #1a1a1a;
      --text-subdued: #555;
      --border-radius: 16px;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .tax-form-container {
      max-width: 540px;
      margin: 60px auto;
      padding: 40px;
      background: var(--bg-color);
      border-radius: var(--border-radius);
      box-shadow: 0 20px 40px -10px rgba(0, 179, 255, 0.2), 0 1px 3px rgba(0,0,0,0.05);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      color: var(--text-main);
      border: 1px solid rgba(0, 179, 255, 0.15);
      border-top: 2px solid rgba(255,255,255,0.8);
      backdrop-filter: blur(10px);
      animation: formFadeIn 0.6s ease-out forwards;
      opacity: 0;
      transform: translateY(15px);
    }

    @keyframes formFadeIn {
      to { opacity: 1; transform: translateY(0); }
    }

    .tax-form-header {
      text-align: center;
      margin-bottom: 35px;
    }

    .tax-form-header h1 {
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 12px;
      letter-spacing: -0.5px;
      color: var(--primary-color);
    }

    .tax-form-header p {
      color: var(--text-subdued);
      font-size: 15px;
      line-height: 1.6;
    }

    .tax-input-group {
      margin-bottom: 24px;
      position: relative;
    }

    .tax-input-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 8px;
      font-size: 13px;
      color: #333;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .tax-input-group input, 
    .tax-input-group select {
      width: 100%;
      padding: 14px 18px;
      border: 2px solid var(--border-color);
      border-radius: 12px;
      font-size: 15px;
      font-family: 'Inter', sans-serif;
      transition: var(--transition);
      box-sizing: border-box;
      background: #fafafa;
      color: var(--text-main);
      box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
    }

    .tax-input-group select {
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background-image: url('data:image/svg+xml;utf8,<svg fill="%23555" height="24" viewBox="0 0 24 24" width="24" xmlns="http://www.w3.org/2000/svg"><path d="M7 10l5 5 5-5z"/></svg>');
      background-repeat: no-repeat;
      background-position-x: 96%;
      background-position-y: center;
      cursor: pointer;
    }

    .tax-input-group input:hover, 
    .tax-input-group select:hover {
      border-color: #bbb;
    }

    .tax-input-group input:focus, 
    .tax-input-group select:focus {
      outline: none;
      border-color: var(--primary-color);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(10, 37, 64, 0.1);
    }

    .tax-input-group input[type="file"] {
      padding: 16px;
      background: #fafafa;
      cursor: pointer;
      border: 2px dashed rgba(10, 37, 64, 0.3);
      color: var(--primary-color);
      font-weight: 600;
      border-radius: 12px;
      padding-right: 48px; /* space for clear button */
    }
    
    .tax-input-group input[type="file"]:hover {
      border-color: var(--primary-color);
      background: #fff;
    }

    .file-input-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .file-clear-btn {
      display: none;
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: #e2e8f0;
      border-radius: 50%;
      width: 28px;
      height: 28px;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #64748b;
      transition: all 0.2s;
    }

    .file-clear-btn:hover {
      background: #cbd5e1;
      color: #d82c0d;
    }

    .tax-submit-btn {
      width: 100%;
      background: var(--primary-color);
      color: #fff;
      padding: 16px 24px;
      border: none;
      border-radius: 12px;
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      box-shadow: 0 4px 12px rgba(10, 37, 64, 0.2);
      position: relative;
      overflow: hidden;
    }

    .tax-submit-btn::after {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
      transition: all 0.5s ease;
    }

    .tax-submit-btn:hover:not(:disabled) {
      transform: translateY(-2px);
      background: var(--primary-hover);
      box-shadow: 0 6px 16px rgba(10, 37, 64, 0.3);
    }

    .tax-submit-btn:hover:not(:disabled)::after {
      left: 100%;
    }

    .tax-submit-btn:active:not(:disabled) {
      transform: translateY(1px);
      box-shadow: 0 2px 10px rgba(0, 102, 255, 0.3);
    }

    .tax-submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      box-shadow: none;
      transform: translateY(0);
      background: #94a3b8;
    }

    .spinner {
      display: none;
      width: 20px;
      height: 20px;
      border: 3px solid rgba(255,255,255,0.3);
      border-radius: 50%;
      border-top-color: #fff;
      animation: spin 1s ease-in-out infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .tax-message {
      margin-top: 20px;
      padding: 16px;
      border-radius: 12px;
      font-size: 14px;
      line-height: 1.5;
      display: none;
      font-weight: 500;
    }

    .tax-message.error {
      display: block;
      background: #FBEAE5;
      color: var(--error-color);
      border: 1px solid #F5C5BE;
    }

    .tax-message.success {
      display: block;
      background: #E3F1DF;
      color: var(--success-color);
      border: 1px solid #BCE3B4;
    }

    .tax-message.info {
      display: block;
      background: #EBF5FA;
      color: #2C6ECB;
      border: 1px solid #B4E1FA;
    }

    .input-warning {
      color: #d82c0d;
      font-size: 13px;
      margin-top: 8px;
      display: none;
      align-items: flex-start;
      gap: 6px;
      line-height: 1.4;
      font-weight: 500;
      background: #fff5f5;
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid #fed7d7;
    }
  </style>

