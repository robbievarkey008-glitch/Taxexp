rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Sessions collection ────────────────────────────────────────────────
    // Only the Firebase Admin SDK (server-side) reads/writes sessions.
    // No client-side access permitted.
    match /sessions/{sessionId} {
      allow read, write: if false;
    }

    // ── Certificates collection ────────────────────────────────────────────
    // No client-side access. All reads/writes go through the Remix server
    // (Admin SDK with service account credentials).
    // Exemption numbers are sensitive business data — treat with PII-level care.
    match /certificates/{certId} {
      allow read, write: if false;
    }

    // ── Shop settings collection ───────────────────────────────────────────
    // No client-side access.
    match /shopSettings/{shopDomain} {
      allow read, write: if false;
    }

    // Default deny-all for anything not listed above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
