{
  "name": "tax-exemption-manager-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Tax Exemption Certificate Manager",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.7.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.8"
  },
  "private": true
}
